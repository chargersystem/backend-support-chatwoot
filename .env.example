# ChargerSystem Chatwoot (Telegram support + AI gateway).
# Full upstream reference: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables

# Generate with `bundle exec rails secret`
SECRET_KEY_BASE=replace_with_lengthy_secure_hex

# Active Record Encryption keys (Telegram bot tokens, webhook secrets, MFA).
# Generate with `bundle exec rails db:encryption:init`; never change them for an existing database.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Public HTTPS origin; the Telegram webhook is built from it
FRONTEND_URL=http://0.0.0.0:3000
# true in production behind HTTPS ingress (needs X-Forwarded-Proto); /health is excluded from the redirect
FORCE_SSL=false

# Postgres
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
# POSTGRES_DATABASE=chatwoot_production

# Redis (Sidekiq, cache, Action Cable)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# Storage: local for docker compose, amazon in EKS (credentials come from IRSA)
ACTIVE_STORAGE_SERVICE=local
# S3_BUCKET_NAME=
# AWS_REGION=

# Email (agent invites, password reset). Without SMTP_ADDRESS Chatwoot falls back to sendmail.
# MAILER_SENDER_EMAIL=ChargerSystem Support <support@example.com>
# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_DOMAIN=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_AUTHENTICATION=login

# New Relic (NEW_RELIC_KEY / NEW_RELIC_APP are accepted as aliases)
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APP_NAME=
# Set to false to disable the agent even when a license key is present.
# NEW_RELIC_ENABLED=true

# ChargerSystem support AI setup (script/setup_support_ai.rb, run after migrations).
# CHATWOOT_BOT_TOKEN and CHATWOOT_WEBHOOK_SECRET must equal the AI gateway values.
# Generate secrets with `openssl rand -hex 32`. The admin password is used only on first creation.
# CHATWOOT_ACCOUNT_NAME=ChargerSystem
# CHATWOOT_ADMIN_EMAIL=
# CHATWOOT_ADMIN_NAME=Administrator
# CHATWOOT_ADMIN_PASSWORD=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_INBOX_NAME=ChargerSystem Telegram
# CHATWOOT_AGENT_BOT_NAME=ChargerSystem AI Bot
# GATEWAY_PUBLIC_URL=https://ai-gateway.example.com
# CHATWOOT_BOT_TOKEN=
# CHATWOOT_WEBHOOK_SECRET=
# Optional: fail when the provisioned ids differ from the gateway configuration.
# CHATWOOT_ACCOUNT_ID=
# CHATWOOT_INBOX_ID=
# CHATWOOT_BOT_ID=
